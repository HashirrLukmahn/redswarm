# ArchRed
ARCHRED_ENABLED=false

ARCHRED_AGENT_COUNT=25
ARCHRED_MODEL_CONCURRENCY=10
ARCHRED_API_CONCURRENCY=5
ARCHRED_BROWSER_CONCURRENCY=2
ARCHRED_RESEARCH_CONCURRENCY=4
ARCHRED_VERIFIER_CONCURRENCY=4

ARCHRED_MAX_MODEL_CALLS=500
ARCHRED_MAX_TOOL_CALLS=500
ARCHRED_MAX_RUN_MINUTES=15

# Which model provider to use for the swarm: mock | gmi
ARCHRED_MODEL_PROVIDER=mock

# Staging target (the local simulator by default). Production is intentionally impossible.
ARCHRED_TARGET_ORIGIN=http://localhost:4600
ARCHRED_ALLOWED_HOSTS=localhost
ARCHRED_STAGING_VERIFICATION_TOKEN=archred-local-dev-token

# Dashboard
ARCHRED_DASHBOARD_PORT=4610
ARCHRED_SIM_PORT=4600

# GMI (primary swarm inference provider; OpenAI-compatible)
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=

# Exa (defensive threat research, research agents only)
EXA_API_KEY=

# Apify (controlled browser execution)
APIFY_API_TOKEN=
APIFY_ARCHRED_ACTOR_ID=

# Gemini (Chief Security Architect, runs only after verified findings exist)
GEMINI_API_KEY=
GEMINI_ARCHITECT_MODEL=gemini-2.0-flash

# Convex (optional realtime state plane; the default StateStore is in-memory)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
